dpo/configs/experiments/full_eval_v10_checkpoints.yaml

# HPO sweep results (Optuna DBs + per-trial JSONs)
dpo/hpo/optuna_results/

# Scripts experimental output (figures + json results)
scripts/phase2_results.json
scripts/phase2_beta_recovery.pdf
scripts/thermo_surplus_analysis.json
scripts/thermo_surplus_figure.pdf
scripts/thermo_surplus_report.json


# ----------------------------------------------------------------------------
# Notebooks (gRNAde upstream + dev exploration)
# ----------------------------------------------------------------------------
notebooks/


# ----------------------------------------------------------------------------
# gRNAde upstream tutorial (third-party; not core to RiboPO)
# ----------------------------------------------------------------------------
tutorial/


# ----------------------------------------------------------------------------
# gRNAde upstream reference checkpoints (download from gRNAde release)
# ----------------------------------------------------------------------------
checkpoints/gRNAde_ARv1_*.h5


# ----------------------------------------------------------------------------
# Training scratch — NEVER track (huge, regenerable)
# ----------------------------------------------------------------------------
wandb/
**/wandb/
runs/
**/runs/
outputs/
**/outputs/
slurm_logs/
**/slurm_logs/
slurm/
**/slurm/
designs_*/
designed_test/
designs_round_*/
nohup.out
eval_log.txt
*.mcout
multiround/runs/
multiround/eval_multiround/
dpo/runs/
dpo/eval_results/
dpo/hpo/optuna_results/
dpo/debug/archive/
dpo/debug/out/
dpo/debug/out_len/
dpo/debug/*test_output/
dpo/debug/*debug/


# ----------------------------------------------------------------------------
# Large data files & external tools — distribute via Zenodo, not git
#
# data/ default-ignore; selectively re-allow split metadata + the preference
# pair set (paper-relevant; ~80 MB but reproducibility-critical).
# tools/ entirely ignored (third-party binaries: ViennaRNA, x3dna, RhoFold).
# ----------------------------------------------------------------------------
data/*
!data/README.md
!data/.gitkeep
!data/das_split.pt
!data/pairs_margin125/
!data/pairs_margin125/**
tools/
**/tools/
backup_checkpoints/

# Top-level orphan artefacts
result_dict.pt
eval.tar.gz
reduce_fail.pdb


# ----------------------------------------------------------------------------
# Checkpoints (.pt / .pth / .ckpt)
#
# Default-ignore all checkpoint files; explicitly allow ONLY the canonical
# paper checkpoints + the dataset-split index. Phase-2 / debug / sweep
# checkpoints stay out (release selectively via Zenodo if needed).
# ----------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.h5
*.tar
*.npz
# canonical paper checkpoints — INCLUDE
!dpo/ckpts/multi_b0.12_rd1.pt
!dpo/ckpts/multi_b0.12_rd2.pt
!dpo/ckpts/multi_b0.12_rd4.pt
!dpo/ckpts/beta0.12_lambda0.10_best_pref_acc.pt
# dataset split file (not a real model ckpt, just .pt-format)
!data/das_split.pt


# ----------------------------------------------------------------------------
# Archives & legacy experiments (kept locally; not part of public release)
# ----------------------------------------------------------------------------
archive_pls_ignore/
old_*/
backup_*/
debug_*/
scratch_*/
**/debug_*/
**/scratch_*/


# ----------------------------------------------------------------------------
# ribopo_v4 (parallel curated workspace) — its code/data has been merged into
# the root. The surviving tree is purely historical; ignore entirely.
# ----------------------------------------------------------------------------
ribopo_v4/


# ----------------------------------------------------------------------------
# ribopo_v2 (next-phase RLPF extension; see docs/lucky-toasting-rocket.md).
# Track code (rlpf/, scripts/, experiments/configs, manuscript/*.tex, docs/);
# ignore run artifacts and the symlinks to shared resources.
# ----------------------------------------------------------------------------
ribopo_v2/outputs/
ribopo_v2/runs_v1
ribopo_v2/data
ribopo_v2/tools
ribopo_v2/checkpoints
ribopo_v2/external
ribopo_v2/wandb/
ribopo_v2/**/__pycache__/
ribopo_v2/**/*.py[cod]
ribopo_v2/**/*.pt
ribopo_v2/**/*.pth
ribopo_v2/**/.ipynb_checkpoints/


