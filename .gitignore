multiround/EVALUATION_SYSTEM_READY.md
multiround/IMPLEMENTATION_SUMMARY.md
multiround/RESUME_TRAINING_GUIDE.md
multiround/passk_individual_analysis.json
multiround/distribution_analysis.py

# Debug / scratch dirs (kept local, not redistributed)
multiround/debug/
dpo/debug/

# Multi-round eval output (huge, regenerable)
multiround/eval_multiround/
multiround/config/experiments/debug/

# Old SimPO sweep / debug configs (exploration, not paper-relevant)
dpo/configs/experiments/debug_eval_*.yaml
dpo/configs/experiments/test_*.yaml
dpo/configs/experiments/exp003_*.yaml
dpo/configs/experiments/exp004_*.yaml
dpo/configs/experiments/exp005_*.yaml
dpo/configs/experiments/exp006_*.yaml
dpo/configs/experiments/exp007_*.yaml
dpo/configs/experiments/exp008_*.yaml
dpo/configs/experiments/exp009_*.yaml
dpo/configs/experiments/exp010_*.yaml
dpo/configs/experiments/exp011_*.yaml
dpo/configs/experiments/exp012_*.yaml
dpo/configs/experiments/exp013_*.yaml
