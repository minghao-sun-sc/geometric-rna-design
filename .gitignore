# ----------------------------------------------------------------------------
test_vienna_fix.py
*.fasta
!data/raw_seq.fasta
arnie_file.txt
molprobity*
**/molprobity*
rna.ps
*.bak
*.backup
*~
*.tmp
*.temp
Miniforge3-Linux-x86_64.sh
exit/


