# ============================================================================
# RiboPO — open-source-ready .gitignore
#
# Strategy:
#   1. Track:    code (src/, dpo/, multiround/), public configs, scripts,
#                docs, manuscript LaTeX SOURCE, the canonical paper checkpoints.
#   2. Don't track: AI-agent state, planning/progress docs, manuscript drafts
#                & build artifacts, templates, papers (other authors'),
#                wandb / runs / outputs / designs_* (training scratch),
#                large data files (distribute via Zenodo), most .pt files.
# ============================================================================


# ----------------------------------------------------------------------------
# AI agent / IDE state — NEVER track
# ----------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
.codex
.codex/
.claude/
.cursor/
.aider*
**/CLAUDE.md
**/AGENTS.md
**/.codex
**/.codex/


# ----------------------------------------------------------------------------
# Progress / planning / status documents (research-non-relevant)
# ----------------------------------------------------------------------------
PROJECT_STATUS.md
PROJECT_STRUCTURE.md
ROADMAP.md
RUN_MANIFEST.md
WORKSPACE_MANIFEST.md
WORKFLOWS.md
CONFIG_INDEX.md
CURATION.md
**/PROJECT_STATUS.md
**/PROJECT_STRUCTURE.md
**/ROADMAP.md
**/RUN_MANIFEST.md
**/WORKSPACE_MANIFEST.md
**/WORKFLOWS.md
**/CONFIG_INDEX.md
**/CURATION.md
**/notes/
**/tasks/
docs/milestones/
**/docs/milestones/
cleanup_summary_report.md


# ----------------------------------------------------------------------------
# Manuscript drafts, private memos, templates, build artifacts
# Source LaTeX *is* tracked; only intermediate/private/heavy stuff is excluded.
# ----------------------------------------------------------------------------

# Private feedback memos & reviewer-facing drafts
manuscript/feedback/
manuscript/ICML_Rebuttal_Material/

# LaTeX templates (third-party, not our content)
manuscript/Springer_Nature_LaTeX_Template/
manuscript/Formatting_Instructions_For_NeurIPS_2026/
manuscript/iclr2026_template/

# LaTeX build artifacts
*.aux
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.synctex*
*.toc
*.lof
*.lot
*.pyg
*.nav
*.snm

# Compiled manuscript PDFs (regenerated from source; don't commit)
manuscript/RiboPO_revision/iclr2026_conference.pdf
manuscript/RiboPO_revision/RiboPO_ICML_submit_vers.pdf
manuscript/RiboPO_ICML_submit/RiboPO_ICML_submit_vers.pdf
**/build_workdir.sh

# Local stub .sty files (workarounds for missing texlive packages on this cluster)
manuscript/RiboPO_revision/makecell.sty
manuscript/RiboPO_revision/multirow.sty
manuscript/RiboPO_revision/wrapfig.sty
manuscript/RiboPO_revision/bbm.sty


# ----------------------------------------------------------------------------
# Other authors' papers / external PDFs (not ours to redistribute)
# ----------------------------------------------------------------------------
external/papers/
**/external/papers/
external/**/*.pdf
**/external/**/*.pdf
docs/RiboPO_ICLR2026.pdf


# ----------------------------------------------------------------------------
# Training scratch — NEVER track (huge, regenerable)
# ----------------------------------------------------------------------------
wandb/
**/wandb/
runs/
**/runs/
outputs/
**/outputs/
slurm_logs/
**/slurm_logs/
slurm/
**/slurm/
designs_*/
designed_test/
designs_round_*/
nohup.out
eval_log.txt
*.mcout
multiround/runs/
multiround/eval_multiround/
dpo/runs/
dpo/eval_results/
dpo/hpo/optuna_results/
dpo/debug/archive/
dpo/debug/out/
dpo/debug/out_len/
dpo/debug/*test_output/
dpo/debug/*debug/


# ----------------------------------------------------------------------------
# Large data files & external tools — distribute via Zenodo, not git
# ----------------------------------------------------------------------------
data/*
!data/README.md
!data/.gitkeep
tools/
**/tools/
backup_checkpoints/


# ----------------------------------------------------------------------------
# Checkpoints (.pt / .pth / .ckpt)
#
# Default-ignore all checkpoint files; explicitly allow ONLY the canonical
# paper checkpoints + the dataset-split index. Phase-2 / debug / sweep
# checkpoints stay out (release selectively via Zenodo if needed).
# ----------------------------------------------------------------------------
*.pt
*.pth
*.ckpt
*.h5
*.tar
*.npz
# canonical paper checkpoints — INCLUDE
!dpo/ckpts/multi_b0.12_rd1.pt
!dpo/ckpts/multi_b0.12_rd2.pt
!dpo/ckpts/multi_b0.12_rd4.pt
!dpo/ckpts/beta0.12_lambda0.10_best_pref_acc.pt
# dataset split file (not a real model ckpt, just .pt-format)
!data/das_split.pt


# ----------------------------------------------------------------------------
# Archives & legacy experiments (kept locally; not part of public release)
# ----------------------------------------------------------------------------
archive_pls_ignore/
old_*/
backup_*/
debug_*/
scratch_*/
**/debug_*/
**/scratch_*/


# ----------------------------------------------------------------------------
# ribopo_v4 (parallel curated workspace) — its code/data has been merged into
# the root. The surviving tree is purely historical; ignore entirely.
# ----------------------------------------------------------------------------
ribopo_v4/


# ----------------------------------------------------------------------------
# Local environment & cluster bootstrap (not for distribution)
# ----------------------------------------------------------------------------
.env
**/.env
.env.bak
**/scripts/cluster_attach.sh
**/scripts/activate_env.sh


# ----------------------------------------------------------------------------
