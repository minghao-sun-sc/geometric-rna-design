# ============================================================================
# RiboPO — open-source-ready .gitignore
#
# Strategy:
#   1. Track:    code (src/, dpo/, multiround/), public configs, scripts,
#                docs, manuscript LaTeX SOURCE, the canonical paper checkpoints.
#   2. Don't track: AI-agent state, planning/progress docs, manuscript drafts
#                & build artifacts, templates, papers (other authors'),
#                wandb / runs / outputs / designs_* (training scratch),
#                large data files (distribute via Zenodo), most .pt files.
# ============================================================================


# ----------------------------------------------------------------------------
# AI agent / IDE state — NEVER track
# ----------------------------------------------------------------------------
CLAUDE.md
AGENTS.md
.codex
.codex/
.claude/
.cursor/
.aider*
**/CLAUDE.md
**/AGENTS.md
**/.codex
**/.codex/


# ----------------------------------------------------------------------------
# Progress / planning / status documents (research-non-relevant)
# ----------------------------------------------------------------------------
PROJECT_STATUS.md
PROJECT_STRUCTURE.md
ROADMAP.md
RUN_MANIFEST.md
WORKSPACE_MANIFEST.md
WORKFLOWS.md
CONFIG_INDEX.md
CURATION.md
**/PROJECT_STATUS.md
**/PROJECT_STRUCTURE.md
**/ROADMAP.md
**/RUN_MANIFEST.md
**/WORKSPACE_MANIFEST.md
**/WORKFLOWS.md
**/CONFIG_INDEX.md
**/CURATION.md
**/notes/
**/tasks/
docs/milestones/
**/docs/milestones/
cleanup_summary_report.md


# ----------------------------------------------------------------------------
# Manuscripts (entire dir)
#
# All manuscript drafts, third-party templates, reviewer materials, and build
# artefacts stay local. The published surface is code + canonical checkpoints
# + minimal data; manuscripts live alongside but are not part of the OSS repo.
# ----------------------------------------------------------------------------
manuscript/

# LaTeX build artefacts (in case any .tex ever sneaks back in)
*.aux
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.synctex*
*.toc
*.lof
*.lot
*.pyg
*.nav
*.snm
**/build_workdir.sh
texput.log


# ----------------------------------------------------------------------------
# Other authors' papers / external PDFs (not ours to redistribute)
# ----------------------------------------------------------------------------
external/papers/
**/external/papers/
external/**/*.pdf
**/external/**/*.pdf
docs/RiboPO_ICLR2026.pdf
RiFold.pdf


# ----------------------------------------------------------------------------
# Internal docs, planning files, debug artefacts (research-non-relevant)
#
# Keep README.md and dpo/README_DPO.md; everything below is internal.
# ----------------------------------------------------------------------------
