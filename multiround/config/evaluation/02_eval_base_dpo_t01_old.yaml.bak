# Multi-checkpoint evaluation config for RiboPO multiround training
# Compares base gRNAde model with DPO-trained checkpoints
# Usage: python -m dpo.bench.eval_full --config multiround/config/evaluation/checkpoint_comparison.yaml

seed: 42
device: cuda

paths:
  processed_pt: data/processed.pt
  split_pt: data/das_split.pt    
  split_name: test               # Evaluate on test set
  
  # Checkpoints to evaluate in comparison
  checkpoints:
    - name: "BASE_gRNAde_das_temp0.1_samp8"
      path: checkpoints/gRNAde_ARv1_1state_das.h5
    - name: "DPO_v3_step16k_temp0.1_samp8"
      path: runs/offline_dpo/dpo_rna_v3/steps/step_0016300.pt
    - name: "DPO_v5_best_temp0.1_samp8"
      path: runs/offline_dpo/dpo_rna_v5/best.pt

featurizer:
  split: test
  radius: 0.0
  top_k: 32
  num_rbf: 32
  num_posenc: 32
  max_num_conformers: 1
  noise_scale: 0.0
  distance_eps: 0.001
  device: cpu

model:
  # EXACT shapes used by gRNAde checkpoints
  name: AutoregressiveMultiGNNv1
  node_in_dim: [15, 4]
  node_h_dim:  [128, 16]
  edge_in_dim: [131, 3]
  edge_h_dim:  [64, 4]
  num_layers: 4
  drop_rate: 0.5
  out_dim: 4

eval:
  batch_size: 16
  num_workers: 6
  pin_memory: true
  
  # Output directory for multiround evaluation results
  out_dir: multiround/eval_multiround
  
  # Sampling parameters - higher sampling for robust statistics
  n_samples: 8                   # Multiple samples per structure for robust evaluation
  temperature: 0.1               # Moderate temperature for diverse but reasonable sampling
  
  # Structure optimization options - dual clash score reporting
  use_relax: true                # Enable Amber relaxation for dual clash scores (pre/post)
  use_lddt: true                 # Enable lDDT calculation for comprehensive structure evaluation

  # Comprehensive metrics suite - all available metrics
  metrics:
    - recovery                   # Sequence recovery (teacher-forced)
    - perplexity                # Model confidence
    - sc_eternafold             # 2D self-consistency with EternaFold
    - sc_rhofold                # 3D self-consistency with RhoFold (full suite)
    - sc_vienna                 # Vienna thermodynamics (MFE, ED, entropy, Tm)
    - diversity_3mer            # 3-mer correlation diversity analysis
  
  # Save designed sequences for analysis
  save_designs: true             # Save all designs as FASTA with metrics
  
  # W&B logging for multiround project
  wandb:
    enable: true
    project: RiboPO-Multiround   # Dedicated project for multiround evaluation
    entity: minghao-sun-soc
    run_name: checkpoint_comparison_eval_t0.1  # Descriptive run name
    tags: ["evaluation", "checkpoint_comparison", "multiround", "dpo"]
    notes: "Comparative evaluation of base gRNAde vs DPO-trained checkpoints with comprehensive metrics"